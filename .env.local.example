# DSR Maison — variables de entorno (frontend)
# Copia este archivo como .env.local y rellena con los valores reales.
# Solo claves públicas — nunca pongas service_role aquí.
#
# Donde encontrarlas: dashboard de Supabase → Settings → API.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Sentry — opcional. Si está vacío, error tracking queda inactivo.
# Crear proyecto en sentry.io (free tier ~5k errors/mes para empezar).
VITE_SENTRY_DSN=
